# Dockerfile for AWS Lambda deployment
# Uses AWS provided runtime image with RIC (Runtime Interface Client)

FROM public.ecr.aws/lambda/python:3.11

# Copy requirements
COPY backend/requirements.txt ${LAMBDA_TASK_ROOT}/

# Install dependencies
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy application code
COPY backend/app ${LAMBDA_TASK_ROOT}/app

# Set working directory
WORKDIR ${LAMBDA_TASK_ROOT}

# Lambda handler
# NOTE: For Mangum (ASGI), use: app.lambda_handler.handler
# NOTE: Update SAM template ImageUri with this image URI after building
CMD ["app.lambda_handler.handler"]
